    {
        int index = i + scrollOffset;

        if (index >= menuLength)
            break;

        int y = 45 + i * 42;

        if (index == selectedItem)
        {
            tft.fillRoundRect(10, y - 5, 210, 30, 6, ST77XX_WHITE);
            tft.setTextColor(ST77XX_BLACK);
        }
        else
        {
            tft.setTextColor(ST77XX_WHITE);
        }

        tft.setCursor(20, y + 5);
        tft.print(menuItems[index]);
    }

    // Scroll indicator
    tft.drawFastVLine(228, 40, 170, ST77XX_WHITE);
    int marker = map(selectedItem, 0, menuLength - 1, 45, 205);
    tft.fillCircle(228, marker, 4, ST77XX_GREEN);
}

