//====================================================
// NFC Functions
//====================================================

void initializeNFC() {
    Wire.begin();
    nfc.begin();

    uint32_t versiondata = nfc.getFirmwareVersion();
    if (!versiondata) {
        Serial.println("Didn't find PN532");
        displayMessage("NFC Error", "No module found");
        while (1);
    }

    Serial.println("PN532 Found!");
    nfc.SAMConfig();
}

String readUID() {
    uint8_t uid[] = { 0, 0, 0, 0, 0, 0, 0 };
    uint8_t uidLength;

    bool success = nfc.readPassiveTargetID(PN532_MIFARE_ISO14443A, uid, &uidLength);

    if (success) {
        String uidString = "";
        for (uint8_t i = 0; i < uidLength; i++) {
            if (uid[i] < 0x10) {
                uidString += "0";
            }
            uidString += String(uid[i], HEX);
            if (i < uidLength - 1) {
                uidString += ":";
            }
        }
        return uidString;
    }
    return "";
}

bool addUIDToList(String uid) {
    if (uidCount >= MAX_UID_STORAGE) {
        return false;
    }
    
    for (int i = 0; i < uidCount; i++) {
        if (uidList[i] == uid) {
            return true;
        }
    }
    
    uidList[uidCount] = uid;
    uidCount++;
    return true;
}

void displayMessage(const char* title, const char* message) {
    tft.fillScreen(ST77XX_BLACK);
    tft.setTextColor(ST77XX_CYAN);
    tft.setTextSize(2);
    tft.setCursor(20, 30);
    tft.print(title);
    
    tft.setTextColor(ST77XX_WHITE);
    tft.setTextSize(1);
    tft.setCursor(20, 80);
    tft.print(message);
    
    tft.setTextColor(ST77XX_YELLOW);
    tft.setCursor(20, 210);
    tft.print("Press SELECT to continue");
    
    delay(100);
}

void showNFCReader() {
    tft.fillScreen(ST77XX_BLACK);
    tft.setTextColor(ST77XX_CYAN);
    tft.setTextSize(2);
    tft.setCursor(20, 20);
    tft.print("NFC Reader");
    
    tft.setTextColor(ST77XX_WHITE);
    tft.setTextSize(1);
    tft.setCursor(20, 70);
    tft.print("Place card near reader");
    
    tft.setTextColor(ST77XX_YELLOW);
    tft.setCursor(20, 210);
    tft.print("SELECT to cancel");
    
    currentUID = "";
    bool uidRead = false;
    unsigned long startTime = millis();
    
    while (!uidRead && (millis() - startTime < 30000)) {
        handleButtons();
        
        if (lastEvent == "SELECT" && selectPressed) {
            currentScreen = MENU;
            drawMenu();
            return;
        }
        
        currentUID = readUID();
        if (currentUID != "") {
            uidRead = true;
            addUIDToList(currentUID);
            
            tft.fillScreen(ST77XX_BLACK);
            tft.setTextColor(ST77XX_GREEN);
            tft.setTextSize(2);
            tft.setCursor(20, 20);
            tft.print("UID Read!");
            
            tft.setTextColor(ST77XX_WHITE);
            tft.setTextSize(1);
            tft.setCursor(20, 70);
            tft.print("UID:");
            tft.setCursor(20, 90);
            tft.setTextSize(2);
            tft.print(currentUID);
            
            tft.setTextSize(1);
            tft.setCursor(20, 140);
            tft.print("Added to list");
            
            tft.setTextColor(ST77XX_YELLOW);
            tft.setCursor(20, 210);
            tft.print("SELECT to continue");
            
            delay(2000);
            currentScreen = MENU;
            drawMenu();
            return;
        }
        
        static unsigned long lastUpdate = 0;
        if (millis() - lastUpdate > 2000) {
            lastUpdate = millis();
            tft.fillRect(20, 100, 200, 20, ST77XX_BLACK);
            tft.setTextColor(ST77XX_WHITE);
            tft.setCursor(20, 100);
            tft.print("Waiting for card...");
        }
        
        delay(100);
    }
    
    if (!uidRead) {
        displayMessage("Timeout", "No card detected");
        delay(2000);
        currentScreen = MENU;
        drawMenu();
    }
}

void showUIDList() {
    tft.fillScreen(ST77XX_BLACK);
    tft.setTextColor(ST77XX_CYAN);
    tft.setTextSize(2);
    tft.setCursor(20, 20);
    tft.print("UID List");
    
    tft.setTextSize(1);
    if (uidCount == 0) {
        tft.setTextColor(ST77XX_WHITE);
        tft.setCursor(20, 70);
        tft.print("No UIDs stored");
    } else {
        tft.setTextColor(ST77XX_WHITE);
        int yPos = 60;
        for (int i = 0; i < uidCount; i++) {
            tft.setCursor(20, yPos);
            tft.print(String(i + 1) + ". " + uidList[i]);
            yPos += 20;
            if (yPos > 190) break;
        }
        
        tft.setTextColor(ST77XX_GREEN);
        tft.setCursor(20, yPos + 20);
        tft.print("Total: " + String(uidCount));
    }
    
    tft.setTextColor(ST77XX_YELLOW);
    tft.setCursor(20, 210);
    tft.print("SELECT to return");
    
    delay(100);
}

//====================================================
// Button Handler
//====================================================

void handleButtons()
{
    bool up = digitalRead(BTN_UP);
    bool down = digitalRead(BTN_DOWN);
    bool select = digitalRead(BTN_SELECT);

    if (lastUp == HIGH && up == LOW)
        lastEvent = "UP";

    if (lastDown == HIGH && down == LOW)
        lastEvent = "DOWN";

    if (lastSelect == HIGH && select == LOW)
    {
        selectPressed = true;
        longPressTriggered = false;
        pressStart = millis();
    }

    if (selectPressed &&
        !longPressTriggered &&
        select == LOW &&
        millis() - pressStart >= LONG_PRESS_TIME)
    {
        longPressTriggered = true;
        lastEvent = "BACK";
    }

    if (lastSelect == LOW && select == HIGH)
    {
        if (!longPressTriggered)
            lastEvent = "SELECT";

        selectPressed = false;
    }

    lastUp = up;
    lastDown = down;
    lastSelect = select;
}

//====================================================
// Menu Navigation
//====================================================

void menuUp()
{
    selectedItem--;
    if (selectedItem < 0)
        selectedItem = menuLength - 1;
    if (selectedItem < scrollOffset)
        scrollOffset = selectedItem;
    drawMenu();
}

void menuDown()
{
    selectedItem++;
    if (selectedItem >= menuLength)
        selectedItem = 0;
    if (selectedItem >= scrollOffset + visibleItems)
        scrollOffset = selectedItem - visibleItems + 1;
    if (selectedItem == 0)
        scrollOffset = 0;
    drawMenu();
}

//====================================================
// Setup
//====================================================

void setup()
{
    Serial.begin(115200);

    pinMode(BTN_UP, INPUT_PULLUP);
    pinMode(BTN_DOWN, INPUT_PULLUP);
    pinMode(BTN_SELECT, INPUT_PULLUP);

    tft.init(240,240);
    tft.setRotation(0);
    
    initializeNFC();
    drawSplash();
}

//====================================================
// Main Loop
//====================================================

void loop()
{
    handleButtons();

    //------------------------------------------------
    // Splash Screen
    //------------------------------------------------

    if (currentScreen == SPLASH)
    {
        if (lastEvent != "")
        {
            currentScreen = MENU;
            drawMenu();
            lastEvent = "";
        }
    }

    //------------------------------------------------
    // Main Menu
    //------------------------------------------------

    else if (currentScreen == MENU)
    {
        if (lastEvent == "UP")
        {
            menuUp();
            lastEvent = "";
        }
        else if (lastEvent == "DOWN")
        {
            menuDown();
            lastEvent = "";
        }
        else if (lastEvent == "SELECT")
        {
            switch (selectedItem) {
                case 0: // E-Wallet
                    currentScreen = E_WALLET;
                    drawWalletPassport();
                    break;
                case 1: // Notes
                    currentScreen = MENU;
                    drawApp("Notes");
                    break;
                case 2: // GPS
                    currentScreen = MENU;
                    drawApp("GPS");
                    break;
                case 3: // Hidden Gems
                    currentScreen = MENU;
                    drawApp("Hidden Gems");
                    break;
                case 4: // Gallery
                    currentScreen = MENU;
                    drawApp("Gallery");
                    break;
            }
            lastEvent = "";
        }
    }

    //------------------------------------------------
    // E-Wallet Screen
    //------------------------------------------------

    else if (currentScreen == E_WALLET)
    {
        if (lastEvent == "BACK" || lastEvent == "SELECT")
        {
            currentScreen = MENU;
            drawMenu();
            lastEvent = "";
        }
    }

    //------------------------------------------------
    // App Screens
    //------------------------------------------------

    else if (currentScreen == MENU)
    {
        if (lastEvent == "BACK" || lastEvent == "SELECT")
        {
            currentScreen = MENU;
            drawMenu();
            lastEvent = "";
        }
    }

    delay(20);
}






